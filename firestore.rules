rules_version = '2';
service cloud.firestore {
  // These rules are applied to the dpcontest database only.
  // App Check should be enabled in the Firebase console for this project.
  match /databases/dpcontest/documents {
  
    // Helper function to check for admin role
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // User profiles
    // Users can only edit their own profile.
    match /users/{userId} {
      // Temporarily allow public reads for debugging
      allow read: if true; 
      allow create: if request.auth.uid == request.resource.data.uid;
      allow update: if isOwner(userId);
      allow write: if isAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if true; // Public read as per existing rules, or switch to isAuthenticated()
      // Allow create if userId matches auth and content is valid
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || request.auth.token.role == 'moderator';
    }

    // Highlights
    // Structure assumed: highlights/{userId}/items/{highlightId} (from hook)
    match /highlights/{userId}/items/{highlightId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
    }
    
    // Follow/unfollow is only managed via Cloud Functions.
    match /following/{userId}/userFollowing/{targetId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by Cloud Function
    }
    
    match /followers/{userId}/userFollowers/{followerId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by Cloud Function
    }
    
    // Existing Rules maintained below:

    // App config is read-only for clients, admin-only for writes
    match /config/app_settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs are admin-only
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Stories Rules
    match /stories/{storyId} {
      // Allow reading stories if they haven't expired
      allow read: if request.auth != null && (resource.data.expiresAt > request.time || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /storyViews/{viewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.viewerUid == request.auth.uid;
    }
  }
}