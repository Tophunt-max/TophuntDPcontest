rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- USER PROFILES ---
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == request.resource.data.uid;
      allow update: if isOwner(userId);
      allow write: if isAdmin(); // Consolidating write access to admin

      match /highlights/{highlightId} {
          allow read: if isAuthenticated();
          allow write: if isOwner(userId);
      }
    }

    // --- CONTESTS & BATTLES ---
    match /contests/{contestId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /entries/{entryId} {
      allow read: if isAuthenticated();
      // Only backend (admin) can write
      allow write: if isAdmin();
    }

    match /battles/{battleId} {
      allow read: if true;
      // Only backend (admin) can write
      allow write: if isAdmin();
    }

    // --- MESSAGING ---
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.users;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }

    // --- POSTS ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
    }

    // --- STORIES ---
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /storyViews/{viewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.viewerUid == request.auth.uid;
    }

    // --- FOLLOW SYSTEM ---
    match /following/{userId}/userFollowing/{targetId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /followers/{userId}/userFollowers/{followerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // --- TRANSACTIONS ---
    match /coin_transactions/{transactionId} {
        allow read: if isOwner(resource.data.userId) || isAdmin();
        // Only backend (admin) can write
        allow write: if isAdmin();
    }

    // --- CONFIG & ADMIN --
    match /config/app_settings {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
