rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Users: Profiles are public, but sensitive data like Dpcoin/xp are read-only
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['Dpcoin', 'xp', 'level', 'stats'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Highlights subcollection
      match /highlights/{highlightId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Contests
    match /contests/{contestId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Contest Matches
    match /contestMatches/{matchId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Votes
    match /votes/{voteId} {
      allow read: if request.auth != null;
      allow write: if false; // ONLY via Cloud Functions
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if request.auth != null && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (
        (resource.data.recipientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        isAdmin()
      );
      allow create, delete: if isAdmin();
    }

    // Admin Notifications
    match /admin_notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // Reports & Support Tickets
    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }
    
    match /support_tickets/{ticketId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Transactions: Read-only for the owner
    match /coinTransactions/{transId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Stories
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Posts
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // Highlights (Top-level, if any. Keeping it for backward compatibility)
    match /highlights/{highlightId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Messaging
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null && request.auth.uid in resource.data.users;
      
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
      }
    }
  }
}
