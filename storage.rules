rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Explicitly allow read/write for contest banners to fix the upload issue
    // We can tighten this later if needed, but for now we need to unblock the admin.
    match /contests/banners/{allPaths=**} {
      allow read, write: if true;
    }

    // Default catch-all: Allow authenticated users to read/write everything
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
