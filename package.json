{
    "name": "instagram-dp-monorepo",
      "private": true,
        "version": "1.0.0",

          "scripts": {
                  "expo:start": "cd apps/expo && npx expo start",
                      "expo:web": "cd apps/expo && npx expo start --web",
                          "expo:build:web": "cd apps/expo && npx expo export",

                                  "admin:dev": "cd apps/admin && npm run dev",
                                      "admin:build": "cd apps/admin && npm run build",
                                          "admin:start": "cd apps/admin && npm start",

                                                  "functions:serve": "cd functions && npm run serve",
                                                      "functions:build": "cd functions && npm run build",
                                                          "functions:deploy": "cd functions && firebase deploy --only functions",

                                                                  "lint": "echo \"Lint handled per-app\""
                                                                    },

                                                                      "devDependencies": {
                                                                          "firebase-tools": "^13.0.0"
                                                                            }
                                                                            }