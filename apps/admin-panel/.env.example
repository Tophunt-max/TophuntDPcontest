# Copy to .env for local dev. In production these are injected at build time
# (Cloudflare Pages build env / GitHub Actions variables).

# tophunt-api Cloudflare Worker base URL
VITE_API_URL=https://tophunt-api.weadown-in.workers.dev

# Firebase web app config (same project as the mobile/web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tophuntdpcontest.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tophuntdpcontest
VITE_FIREBASE_STORAGE_BUCKET=tophuntdpcontest.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
