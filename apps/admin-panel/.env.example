# Copy to .env for local dev. In production these are injected at build time
# (Cloudflare Pages build env / GitHub Actions variables) — see .env.production.

# tophunt-api Cloudflare Worker base URL
VITE_API_URL=https://api.tophunt.in

# Firebase web app config (same project as the mobile/web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tophuntdpcontest.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tophuntdpcontest
# The modern bucket host. This example previously said `appspot.com` while
# .env.production said `firebasestorage.app`, so copying it produced a config
# that differed from production in a way nothing would flag until a storage call
# failed.
VITE_FIREBASE_STORAGE_BUCKET=tophuntdpcontest.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
