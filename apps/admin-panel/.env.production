# Production build config for the TopHunt admin panel.
# These VITE_FIREBASE_* values are the Firebase *web app* config — they are
# public client values (they ship in the browser bundle) and are safe to commit.
# The tophunt-api Worker still verifies the resulting ID token + admin role.
#
# Reminder: admin.tophunt.in must be listed under Firebase Authentication ->
# Settings -> Authorized domains, or every sign-in on this host is rejected by
# Firebase before the Worker is ever called.

VITE_API_URL=https://api.tophunt.in

VITE_FIREBASE_API_KEY=AIzaSyDTNJOrXA1bIyUTKozhuDw7wKdzYZrn2D8
VITE_FIREBASE_AUTH_DOMAIN=tophuntdpcontest.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tophuntdpcontest
VITE_FIREBASE_STORAGE_BUCKET=tophuntdpcontest.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1055570975270
VITE_FIREBASE_APP_ID=1:1055570975270:web:cff6347dab76bb104b24e7
