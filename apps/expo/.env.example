# Deployed Cloudflare Worker backend URL.
# Also derives the realtime WebSocket base (src/services/realtime.ts swaps
# http -> ws), so this must be the API host, not the web host.
EXPO_PUBLIC_API_URL=https://api.tophunt.in

# Public web host used to build shareable links (battle links, story shares).
# On web this is ignored — window.location.origin is used — so it only matters
# for NATIVE builds, which have no browser location. Without it, shareOrigin()
# falls back to the API origin and produces links on https://api.tophunt.in,
# which does not serve the app.
EXPO_PUBLIC_SHARE_ORIGIN=https://tophunt.in
