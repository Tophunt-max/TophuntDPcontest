# Copy to `.dev.vars` for local `wrangler dev`, and set in production with
# `wrangler secret put <NAME>`. Do NOT commit real values.

# Firebase Admin service account JSON (single line, escaped). Used to mint OAuth
# tokens for the Identity Toolkit REST API (create/update/delete users, custom
# claims) and FCM HTTP v1 push. Get it from Firebase console > Project settings >
# Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"tophuntdpcontest","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@tophuntdpcontest.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'

# R2 S3-compatible credentials (R2 dashboard > Manage R2 API Tokens).
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=tophunt-media

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Email (Resend or compatible HTTP email API)
RESEND_API_KEY=re_xxxxxxxx
# Must be on a domain you have verified with the provider, with SPF + DKIM
# records published. `tophunt.in` is the production sender domain; lib/email.ts
# falls back to "TopHunt <no-reply@tophunt.in>" when this is unset.
EMAIL_FROM=TopHunt <no-reply@tophunt.in>


# Shared secret for server-to-server admin calls from the admin Next.js API
# routes (sent as the X-Admin-Secret header). Generate a long random string.
ADMIN_PROXY_SECRET=change_me_to_a_long_random_string

# ---------------------------------------------------------------------------
# Razorpay (coin top-ups). BOTH of these are fail-closed by design:
#   * Without RAZORPAY_KEY_SECRET, every top-up verification is rejected — coins
#     are never free-minted. Symptom: all purchases fail with no obvious cause.
#   * Without RAZORPAY_WEBHOOK_SECRET, /webhook/razorpay returns
#     503 not_configured and Razorpay retries forever.
# So a production deploy that forgets these looks "up" but cannot take payments.
# Key id/secret: Razorpay dashboard > Settings > API Keys.
# Webhook secret: Razorpay dashboard > Settings > Webhooks (set when you create
# the webhook; it signs the RAW request body).
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# ---------------------------------------------------------------------------
# Qencode (video transcoding).
#
# Qencode dashboard > Projects > your project > API key. The key stays in the
# Worker: the app uploads the raw file to the Worker (POST /upload/video), which
# stores it in R2 and starts the Qencode job. Qencode reads the source through a
# presigned R2 URL and writes HLS back into R2, so it ALSO needs the R2_* values
# above (use an R2 API token scoped to the media bucket, Object Read & Write).
# Fail-closed — with any of these unset, video keeps using the legacy R2 path.
# Callbacks need no secret: each job's callback URL carries a per-video HMAC
# derived from this key.
QENCODE_API_KEY=

# ---------------------------------------------------------------------------
# Local-dev CORS override. `.dev.vars` takes precedence over [vars] in
# wrangler.toml under `wrangler dev`, so put localhost origins here instead of
# widening the production allow-list.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173


# ---------------------------------------------------------------------------
# Error tracking (optional locally, REQUIRED in production).
#
# These are read by src/lib/observability.ts. `captureError` is a no-op without a
# DSN, which is why they were easy to miss: a fresh deploy silently has no error
# tracking at all, and the only clue is the absence of events in Sentry.
#
# Cron failures, unhandled request errors and clawback problems are all forwarded
# here, and those are exactly the failures nobody notices from the request path.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Pre-deploy secret checklist. Every one of these is fail-CLOSED in code, which
# means a missing value does not crash the Worker — it quietly disables a
# user-visible flow. `GET /health/deep` reports which of them are absent.
#
#   FIREBASE_SERVICE_ACCOUNT   admin user operations, custom tokens
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET
#                              Qencode video pipeline (presigned source, output)
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET
#                              top-ups AND the payment reconciliation sweep
#   RAZORPAY_WEBHOOK_SECRET    webhook 503s without it -> paid-but-uncredited
#   TWILIO_* / RESEND_API_KEY / EMAIL_FROM
#                              OTP delivery
#   ADMIN_PROXY_SECRET         server-to-server admin calls
#   SENTRY_DSN                 error tracking
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Panel-managed credentials.
#
# Every credential above can ALSO be set from the admin panel (Integrations
# page), where it is stored AES-256-GCM encrypted in D1. This key is what
# encrypts them, so it stays a Cloudflare secret and is never written to the
# database — the encrypted rows are useless without it.
#
#   Generate:  openssl rand -base64 32
#   Set:       wrangler secret put SETTINGS_ENCRYPTION_KEY
#
# Without it, panel credential writes are REFUSED (there is no plaintext
# fallback) and the environment variables above are used exactly as before.
#
# Resolution order for every credential is: panel value first, environment
# second. `GET /admin/integrations` reports which source is actually in effect,
# so there is never ambiguity about what is live.
#
# WARNING: rotating this key makes every stored credential undecryptable. The
# affected credentials must be re-entered in the panel (the environment values
# keep working in the meantime).
# ---------------------------------------------------------------------------
SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Alternative SMS gateways. The ACTIVE gateway is chosen in the admin panel;
# these are only the fallback credentials. Indian DLT gateways are usually much
# cheaper than Twilio for OTP traffic.
# ---------------------------------------------------------------------------
MSG91_AUTH_KEY=
FAST2SMS_API_KEY=
# Token substituted into a custom gateway's URL/body as {token}.
SMS_CUSTOM_TOKEN=

# Alternative transactional email provider (Resend is the other option).
BREVO_API_KEY=
