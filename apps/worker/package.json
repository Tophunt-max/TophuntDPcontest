{
  "name": "@tophunt/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker backend for TopHunt DP Contest (D1 + R2 + KV). Auth stays on Firebase.",
  "main": "src/index.ts",
  "scripts": {
    "predev": "wrangler d1 migrations apply tophunt-db --local",
    "dev": "wrangler dev",
    "predeploy": "wrangler d1 migrations apply tophunt-db --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate": "wrangler d1 migrations apply tophunt-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply tophunt-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tophunt-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "node-html-parser": "^9.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.90.0"
  }
}
